import "std/time";
import "std/conv";

# Pong. Your paddle is on the left: ArrowUp / ArrowDown to move. The right
# paddle is a simple tracking AI. First to 11 wins. q quits. Canvas-rendered.

let SCREEN_WIDTH = 640;
let SCREEN_HEIGHT = 480;
let PADDLE_WIDTH = 12;
let PADDLE_HEIGHT = 80;
let BALL_RADIUS = 8;

struct Ball { x: real, y: real, vx: real, vy: real }

struct Paddle { x: int, y: real, score: int }

impl Ball {
    void serve(self, toward_left: bool) {
        self.x = (SCREEN_WIDTH / 2) as real;
        self.y = (SCREEN_HEIGHT / 2) as real;
        self.vy = 2.5;
        if (toward_left) { self.vx = -4.0; } else { self.vx = 4.0; }
    }

    void advance(self) {
        self.x = self.x + self.vx;
        self.y = self.y + self.vy;
    }

    void bounce_off_walls(self) {
        let radius = BALL_RADIUS as real;
        if (self.y < radius) {
            self.y = radius;
            self.vy = -self.vy;
        }
        let floor = (SCREEN_HEIGHT - BALL_RADIUS) as real;
        if (self.y > floor) {
            self.y = floor;
            self.vy = -self.vy;
        }
    }
}

impl Paddle {
    int center(self) { return (self.y as int) + PADDLE_HEIGHT / 2; }

    void nudge(self, delta: int) {
        self.y = self.y + (delta as real);
        let lowest = (SCREEN_HEIGHT - PADDLE_HEIGHT) as real;
        if (self.y < 0.0) { self.y = 0.0; }
        if (self.y > lowest) { self.y = lowest; }
    }

    # Track the ball's vertical position, but with a capped speed so the AI
    # can lose.
    void follow(self, ball: Ball) {
        let target = (ball.y as int) - PADDLE_HEIGHT / 2;
        if (target > (self.y as int) + 4) { self.nudge(5); }
        if (target < (self.y as int) - 4) { self.nudge(-5); }
    }

    bool blocks(self, ball: Ball) {
        let radius = BALL_RADIUS as real;
        let front = (self.x + PADDLE_WIDTH) as real;
        let overlap_x = ball.x + radius > (self.x as real) && ball.x - radius < front;

        let ball_y = ball.y as int;
        let overlap_y = ball_y + BALL_RADIUS > (self.y as int)
                     && ball_y - BALL_RADIUS < (self.y as int) + PADDLE_HEIGHT;

        let on_left = self.x < SCREEN_WIDTH / 2;
        let approaching = (on_left && ball.vx < 0.0) || (!on_left && ball.vx > 0.0);

        return overlap_x && overlap_y && approaching;
    }

    # Reflect the ball, speed it up slightly, and angle it by where it struck
    # the paddle.
    void deflect(self, ball: Ball) {
        ball.vx = -ball.vx * 1.05;
        let offset = ((ball.y as int) - self.center()) as real;
        ball.vy = offset / 7.0;
    }
}

void render(ball: Ball, player: Paddle, ai: Paddle) {
    draw_clear();

    set_color("#0f172a");
    fill_rect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);

    set_color("#1e293b");
    for (let y = 10; y < SCREEN_HEIGHT; y = y + 30) {
        fill_rect(SCREEN_WIDTH / 2 - 2, y, 4, 16);
    }

    set_color("#e2e8f0");
    fill_rect(player.x, player.y as int, PADDLE_WIDTH, PADDLE_HEIGHT);
    fill_rect(ai.x, ai.y as int, PADDLE_WIDTH, PADDLE_HEIGHT);

    set_color("#facc15");
    fill_circle(ball.x as int, ball.y as int, BALL_RADIUS);

    set_color("#94a3b8");
    set_font_size(36);
    draw_text(conv.to_string::<int>(player.score), SCREEN_WIDTH / 2 - 60, 56);
    draw_text(conv.to_string::<int>(ai.score), SCREEN_WIDTH / 2 + 36, 56);
}

void render_result(player: Paddle, ai: Paddle) {
    set_color("#0f172a");
    fill_rect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
    set_color("#facc15");
    set_font_size(40);
    if (player.score > ai.score) {
        draw_text("YOU WIN", SCREEN_WIDTH / 2 - 90, SCREEN_HEIGHT / 2);
    } else {
        draw_text("AI WINS", SCREEN_WIDTH / 2 - 90, SCREEN_HEIGHT / 2);
    }
    set_color("#e2e8f0");
    set_font_size(20);
    let line = conv.to_string::<int>(player.score) + " - " + conv.to_string::<int>(ai.score);
    draw_text(line, SCREEN_WIDTH / 2 - 30, SCREEN_HEIGHT / 2 + 40);
}

int main() {
    let middle = (SCREEN_HEIGHT / 2 - PADDLE_HEIGHT / 2) as real;
    let ball = new Ball {
        x: (SCREEN_WIDTH / 2) as real,
        y: (SCREEN_HEIGHT / 2) as real,
        vx: -4.0,
        vy: 2.5,
    };
    let player = new Paddle { x: 20, y: middle, score: 0 };
    let ai = new Paddle { x: SCREEN_WIDTH - 20 - PADDLE_WIDTH, y: middle, score: 0 };

    render(ball, player, ai);
    time.sleep(800);

    while (!is_key_down("q") && player.score < 11 && ai.score < 11) {
        if (is_key_down("ArrowUp"))   { player.nudge(-7); }
        if (is_key_down("ArrowDown")) { player.nudge(7); }
        ai.follow(ball);

        ball.advance();
        ball.bounce_off_walls();

        if (player.blocks(ball)) { player.deflect(ball); }
        if (ai.blocks(ball))     { ai.deflect(ball); }

        if (ball.x < 0.0) {
            ai.score = ai.score + 1;
            ball.serve(false);
        }
        if (ball.x > SCREEN_WIDTH as real) {
            player.score = player.score + 1;
            ball.serve(true);
        }

        render(ball, player, ai);
        time.sleep(16);
    }

    render_result(player, ai);
    return 0;
}
