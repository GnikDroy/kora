import "std/net";
import "std/io";
import "std/env";
import "std/conv";

# httpget: fetch http://<domain>[:<port>]/ and print the response to stdout.

int main() {
    let argv = env.args();
    if (argv.len() < 2) {
        io.print("usage: httpget <domain> [port]");
        return 1;
    }
    let host = argv[1];

    let port = 80;
    if (argv.len() >= 3) {
        let parsed = conv.string_to_int(argv[2]);
        if (parsed != none) {
            port = parsed!;
        }
    }

    let opened = net.connect(host, port);
    if (opened == none) {
        io.print("could not connect to " + host);
        return 1;
    }
    let sock = opened!;

    let request = "GET / HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
    if (!sock.send_all(request)) {
        io.print("send failed");
        sock.close();
        return 1;
    }

    let chunk = sock.recv(4096);
    while (chunk != none) {
        let data = chunk!;
        if (data.len() == 0) {
            break;
        }
        io.write(data);
        chunk = sock.recv(4096);
    }
    sock.close();
    return 0;
}
