# Chess: play White against a shallow-search negamax AI.
#
# The board is 64 chars indexed as row * 8 + col; row 0 is Black's
# home rank at the top of the printed board. White pieces are
# uppercase (P N B R Q K), Black lowercase, ' ' is empty. Enter moves
# in the stdin box below as from-to squares, e.g. "e2e4". Pawns
# auto-promote to queen; castling, en passant, and check detection are
# not implemented. The game ends when a king is captured.
#
# Squares travel as a single int 0..63, moves as from * 64 + to.

bool is_white(p: char) { return p >= 'A' && p <= 'Z'; }

bool is_black(p: char) { return p >= 'a' && p <= 'z'; }

bool mine(p: char, white_to_move: bool) {
    return p != ' ' && is_white(p) == white_to_move;
}

int sign(x: int) {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

int abs_val(x: int) {
    if (x < 0) { return -x; }
    return x;
}

# For from -> to known to be diagonal or orthogonal, is every square
# strictly between them empty?
bool path_clear(b: [char], from: int, to: int) {
    let step = sign(to / 8 - from / 8) * 8 + sign(to % 8 - from % 8);
    let sq = from + step;
    while (sq != to) {
        if (b[sq] != ' ') { return false; }
        sq = sq + step;
    }
    return true;
}

# Standard piece movement plus "no capturing your own piece". King
# safety is not enforced; games resolve by king capture.
bool is_legal_move(b: [char], from: int, to: int) {
    if (from == to) { return false; }
    let piece = b[from];
    if (piece == ' ') { return false; }
    let target = b[to];
    if (target != ' ' && is_white(target) == is_white(piece)) { return false; }

    let dr = to / 8 - from / 8;
    let dc = to % 8 - from % 8;
    let adr = abs_val(dr);
    let adc = abs_val(dc);

    if (piece == 'P' || piece == 'p') {
        # White pawns march toward row 0.
        let dir = 1;
        let home = 1;
        if (piece == 'P') {
            dir = -1;
            home = 6;
        }
        if (dc == 0 && target == ' ') {
            if (dr == dir) { return true; }
            return dr == 2 * dir && from / 8 == home && b[from + dir * 8] == ' ';
        }
        return adc == 1 && dr == dir && target != ' ';
    }
    if (piece == 'N' || piece == 'n') {
        return (adr == 2 && adc == 1) || (adr == 1 && adc == 2);
    }
    if (piece == 'K' || piece == 'k') {
        return adr <= 1 && adc <= 1;
    }
    let straight = adr == 0 || adc == 0;
    let diagonal = adr == adc;
    if (piece == 'B' || piece == 'b') { straight = false; }
    if (piece == 'R' || piece == 'r') { diagonal = false; }
    return (straight || diagonal) && path_clear(b, from, to);
}

# Play from -> to in place, promoting pawns to queen on the last rank.
# Returns the pre-move (mover, captured) pair packed into an int so
# undo_move can restore the position exactly. Moves are not validated.
int apply_move(b: [char], from: int, to: int) {
    let moving = b[from];
    let placed = moving;
    if (moving == 'P' && to < 8) { placed = 'Q'; }
    if (moving == 'p' && to >= 56) { placed = 'q'; }
    let undo = (moving as int) * 256 + (b[to] as int);
    b[to] = placed;
    b[from] = ' ';
    return undo;
}

void undo_move(b: [char], from: int, to: int, undo: int) {
    b[from] = (undo / 256) as char;
    b[to] = (undo % 256) as char;
}

# Material value in centipawns, White positive.
int piece_value(p: char) {
    let l = p;
    if (is_white(p)) { l = ((p as int) + 32) as char; }
    let v = 0;
    if (l == 'p') { v = 100; }
    if (l == 'n') { v = 320; }
    if (l == 'b') { v = 330; }
    if (l == 'r') { v = 500; }
    if (l == 'q') { v = 900; }
    if (l == 'k') { v = 20000; }
    if (is_black(p)) { return -v; }
    return v;
}

int material_eval(b: [char]) {
    let s = 0;
    for (let i = 0; i < 64; i = i + 1) {
        s = s + piece_value(b[i]);
    }
    return s;
}

# 'W' if the Black king is missing (White won), 'B' if the White king
# is missing, else ' '.
char king_winner(b: [char]) {
    let white_king = false;
    let black_king = false;
    for (let i = 0; i < 64; i = i + 1) {
        if (b[i] == 'K') { white_king = true; }
        if (b[i] == 'k') { black_king = true; }
    }
    if (!white_king) { return 'B'; }
    if (!black_king) { return 'W'; }
    return ' ';
}

# Depth-limited negamax with a material-only leaf evaluation, scored
# for the side to move. A missing king short-circuits to a huge
# win/loss score so we never search past a king capture.
int negamax(b: [char], depth: int, white_to_move: bool) {
    let w = king_winner(b);
    if (w != ' ') {
        if ((w == 'W') == white_to_move) { return 30000; }
        return -30000;
    }
    if (depth == 0) {
        let m = material_eval(b);
        if (white_to_move) { return m; }
        return -m;
    }

    let best = -100000;
    let any = false;
    for (let from = 0; from < 64; from = from + 1) {
        if (mine(b[from], white_to_move)) {
            for (let to = 0; to < 64; to = to + 1) {
                if (is_legal_move(b, from, to)) {
                    any = true;
                    let undo = apply_move(b, from, to);
                    let score = -negamax(b, depth - 1, !white_to_move);
                    undo_move(b, from, to, undo);
                    if (score > best) { best = score; }
                }
            }
        }
    }
    if (!any) { return 0; }
    return best;
}

# Black's best move, or -1 if Black has none.
int black_choose_move(b: [char], depth: int) {
    let best_code = -1;
    let best_score = -100000;
    for (let from = 0; from < 64; from = from + 1) {
        if (is_black(b[from])) {
            for (let to = 0; to < 64; to = to + 1) {
                if (is_legal_move(b, from, to)) {
                    let undo = apply_move(b, from, to);
                    let score = -negamax(b, depth - 1, true);
                    undo_move(b, from, to, undo);
                    if (score > best_score) {
                        best_score = score;
                        best_code = from * 64 + to;
                    }
                }
            }
        }
    }
    return best_code;
}

bool has_any_move(b: [char], white_to_move: bool) {
    for (let from = 0; from < 64; from = from + 1) {
        if (mine(b[from], white_to_move)) {
            for (let to = 0; to < 64; to = to + 1) {
                if (is_legal_move(b, from, to)) { return true; }
            }
        }
    }
    return false;
}

void print_board(b: [char]) {
    print("\n    a   b   c   d   e   f   g   h\n");
    print("  +---+---+---+---+---+---+---+---+\n");
    for (let r = 0; r < 8; r = r + 1) {
        # Row 0 -> rank 8, row 7 -> rank 1.
        let rank = (56 - r) as char;
        print([' ', rank, ' ']);
        for (let c = 0; c < 8; c = c + 1) {
            let p = b[r * 8 + c];
            if (p == ' ') { p = '.'; }
            print(['|', ' ', p, ' ']);
        }
        print(['|', ' ', rank, '\n']);
        print("  +---+---+---+---+---+---+---+---+\n");
    }
    print("    a   b   c   d   e   f   g   h\n\n");
}

# "e2"-style file and rank chars to a square 0..63, or -1.
int parse_square(file: char, rank: char) {
    let c = (file as int) - 97;
    if (c < 0 || c > 7) { c = (file as int) - 65; }
    let r = 56 - (rank as int);
    if (c < 0 || c > 7 || r < 0 || r > 7) { return -1; }
    return r * 8 + c;
}

# The first four non-whitespace chars of s as "<from><to>", encoded as
# from * 64 + to; -1 on malformed input.
int parse_move(s: string) {
    let sq = new char[0];
    for (let i = 0; i < s.len() && sq.len() < 4; i = i + 1) {
        let c = s[i];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
            sq.push(c);
        }
    }
    if (sq.len() != 4) { return -1; }
    let from = parse_square(sq[0], sq[1]);
    let to = parse_square(sq[2], sq[3]);
    if (from == -1 || to == -1) { return -1; }
    return from * 64 + to;
}

void print_move(code: int) {
    let from = code / 64;
    let to = code % 64;
    print([
        (from % 8 + 97) as char, (56 - from / 8) as char,
        (to % 8 + 97) as char, (56 - to / 8) as char,
    ]);
}

void setup_initial(b: [char]) {
    let back = "rnbqkbnr";
    for (let c = 0; c < 8; c = c + 1) {
        b[c] = back[c];
        b[8 + c] = 'p';
        for (let r = 2; r < 6; r = r + 1) { b[r * 8 + c] = ' '; }
        b[48 + c] = 'P';
        b[56 + c] = ((back[c] as int) - 32) as char;
    }
}

# Prompt until the user enters a legal White move, then play it.
void human_move(b: [char]) {
    while (true) {
        print("Your move (e.g. e2e4): ");
        let code = parse_move(input());
        if (code == -1) {
            print("  Malformed. Enter from-to squares like e2e4.\n");
        } else if (!is_white(b[code / 64])) {
            print("  That square isn't one of your pieces.\n");
        } else if (!is_legal_move(b, code / 64, code % 64)) {
            print("  That move isn't legal for that piece.\n");
        } else {
            apply_move(b, code / 64, code % 64);
            return;
        }
    }
}

int main() {
    let board = new char[64];
    setup_initial(board);

    print("=== Kora Chess ===\n");
    print("You play White (uppercase). AI plays Black (lowercase).\n");
    print("Enter moves as from-to squares, e.g. \"e2e4\".\n");
    print("Pawns auto-promote to queen. Castling and en passant\n");
    print("are not supported. Game ends on king capture.\n");

    let white_to_move = true;
    let done = false;
    while (!done) {
        print_board(board);
        if (king_winner(board) != ' ' || !has_any_move(board, white_to_move)) {
            done = true;
        } else if (white_to_move) {
            human_move(board);
            white_to_move = false;
        } else {
            print("AI is thinking...\n");
            let code = black_choose_move(board, 2);
            apply_move(board, code / 64, code % 64);
            print("AI plays ");
            print_move(code);
            print(".\n");
            white_to_move = true;
        }
    }

    let w = king_winner(board);
    if (w == 'W') {
        print("You win! Black king captured.\n");
    } else if (w == 'B') {
        print("AI wins. Your king was captured.\n");
    } else {
        print("Draw (no legal moves).\n");
    }
    return 0;
}
