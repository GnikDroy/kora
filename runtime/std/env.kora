import "std/libc";

extern cint __kora_argc();
extern cstring? __kora_argv(i: cint);
extern cint __kora_setenv(name: cstring, value: cstring);
extern cint __kora_unsetenv(name: cstring);

string? get(name: string) {
    return libc.getenv(name);
}

[string] args() {
    let out: [string] = [];
    let n = __kora_argc();
    let i = 0;
    while (i < n) {
        let a = __kora_argv(i);
        if (a != none) {
            out.push(a!);
        }
        i = i + 1;
    }
    return out;
}

bool set(name: string, value: string) {
    return __kora_setenv(name, value) == 0;
}

bool unset(name: string) {
    return __kora_unsetenv(name) == 0;
}
