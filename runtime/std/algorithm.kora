void sort<T, C>(xs: [T], cmp: C) {
    sort_range::<T, C>(xs, 0, xs.len() - 1, cmp);
}

void sort_range<T, C>(xs: [T], lo: int, hi: int, cmp: C) {
    while (lo < hi) {
        let pivot = xs[hi];
        let store = lo;
        let scan = lo;
        while (scan < hi) {
            if (cmp.less(xs[scan], pivot)) {
                let t = xs[store];
                xs[store] = xs[scan];
                xs[scan] = t;
                store = store + 1;
            }
            scan = scan + 1;
        }
        let t = xs[store];
        xs[store] = xs[hi];
        xs[hi] = t;
        if (store - lo < hi - store) {
            sort_range::<T, C>(xs, lo, store - 1, cmp);
            lo = store + 1;
        } else {
            sort_range::<T, C>(xs, store + 1, hi, cmp);
            hi = store - 1;
        }
    }
}

int? binary_search<T, C>(xs: [T], key: T, cmp: C) {
    let lo = 0;
    let hi = xs.len();
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        if (cmp.less(xs[mid], key)) {
            lo = mid + 1;
        } else if (cmp.less(key, xs[mid])) {
            hi = mid;
        } else {
            return mid;
        }
    }
    return none;
}
