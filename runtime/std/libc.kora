extern cint putchar(c: cint);
extern cint getchar();
extern cint rand();
extern void srand(seed: cuint);
extern void abort();
extern cstring strerror(errnum: cint);

extern opaque? fopen(path: cstring, mode: cstring);
extern cint fclose(f: opaque);
extern cint fgetc(f: opaque);
extern cint fputc(c: cint, f: opaque);
extern cint fputs(s: cstring, f: opaque);
extern cint fflush(f: opaque?);
extern clong ftell(f: opaque);
extern cint fseek(f: opaque, offset: clong, whence: cint);
extern cint remove(path: cstring);
extern cint rename(old: cstring, to: cstring);

extern cstring? getenv(name: cstring);
extern cint system(cmd: cstring);
extern void exit(code: cint);
extern clong time(t: opaque?);

extern float64 sqrt(x: float64);
extern float64 sin(x: float64);
extern float64 cos(x: float64);
extern float64 tan(x: float64);
extern float64 atan(x: float64);
extern float64 atan2(y: float64, x: float64);
extern float64 pow(base: float64, exp: float64);
extern float64 floor(x: float64);
extern float64 ceil(x: float64);
extern float64 round(x: float64);
extern float64 exp(x: float64);
extern float64 log(x: float64);
extern float64 log2(x: float64);
extern float64 log10(x: float64);
extern float64 asin(x: float64);
extern float64 acos(x: float64);
extern float64 sinh(x: float64);
extern float64 cosh(x: float64);
extern float64 tanh(x: float64);
extern float64 hypot(x: float64, y: float64);
extern float64 cbrt(x: float64);
extern float64 trunc(x: float64);
extern float64 fmod(x: float64, y: float64);
extern float64 fabs(x: float64);
extern float64 fmin(x: float64, y: float64);
extern float64 fmax(x: float64, y: float64);
