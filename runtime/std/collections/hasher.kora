struct int_hasher {}
impl int_hasher {
    int hash(self, key: int) {
        return (key ^ (key >> 32)) & 4294967295;
    }
}

struct string_hasher {}
impl string_hasher {
    int hash(self, key: string) {
        let h = 5381;
        let i = 0;
        while (i < key.len()) {
            h = ((h * 33) + (key[i] as int)) & 4294967295;
            i = i + 1;
        }
        return h;
    }
}

struct char_hasher {}
impl char_hasher {
    int hash(self, key: char) {
        return key as int;
    }
}

struct bool_hasher {}
impl bool_hasher {
    int hash(self, key: bool) {
        if (key) {
            return 1;
        }
        return 0;
    }
}
