# Hashes any supported key: the primitives here, or any struct with an
# `int __hash__(self)` method.
int hash<T>(key: T) {
    if T == int {
        return (key ^ (key >> 32)) & 4294967295;
    } else if T == string {
        let h = 5381;
        let i = 0;
        while (i < key.len()) {
            h = ((h * 33) + (key[i] as int)) & 4294967295;
            i = i + 1;
        }
        return h;
    } else if T == char {
        return key as int;
    } else if T == bool {
        if (key) {
            return 1;
        }
        return 0;
    } else {
        return key.__hash__();
    }
}
