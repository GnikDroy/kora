import "std/libc";

void write(s: string) {
    libc.write(1, s, s.len());
}

void print(s: string) {
    write(s);
    write("\n");
}

string? input() {
    let line = "";
    let c = libc.getchar();
    while (c != -1 && c != ('\n' as int)) {
        line.push(c as char);
        c = libc.getchar();
    }
    if (c == -1 && line.len() == 0) {
        return none;
    }
    return line;
}
