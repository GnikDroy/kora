import "std/libc";

extern void __kora_write(buf: cstring, n: csize);
extern cint __kora_isatty(fd: cint);

void write(s: string) {
    __kora_write(s, s.len());
}

void print(s: string) {
    write(s);
    write("\n");
}

bool is_tty() {
    return __kora_isatty(1) == 1;
}

string? input() {
    let line = "";
    let c = libc.getchar();
    while (c != -1 && c != ('\n' as int)) {
        line.push(c as char);
        c = libc.getchar();
    }
    if (c == -1 && line.len() == 0) {
        return none;
    }
    return line;
}
