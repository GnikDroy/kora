import "std/libc";

real random() {
    let hi = libc.rand() % 32768;
    let mid = libc.rand() % 32768;
    let lo = libc.rand() % 32768;
    return (((hi * 32768 + mid) * 32768 + lo) as real) / 35184372088832.0;
}

int abs(n: int) {
    if (n < 0) {
        return -n;
    }
    return n;
}

int min(a: int, b: int) {
    if (a < b) {
        return a;
    }
    return b;
}

int max(a: int, b: int) {
    if (a > b) {
        return a;
    }
    return b;
}

int clamp(v: int, lo: int, hi: int) {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

int pow(base: int, exp: int) {
    if (exp < 0) {
        return 0;
    }
    let result = 1;
    while (exp > 0) {
        result = result * base;
        exp = exp - 1;
    }
    return result;
}

int gcd(a: int, b: int) {
    if (a < 0) {
        a = -a;
    }
    if (b < 0) {
        b = -b;
    }
    while (b != 0) {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}


real absf(x: real) {
    if (x < 0.0) {
        return -x;
    }
    return x;
}

int sign(n: int) {
    if (n > 0) {
        return 1;
    }
    if (n < 0) {
        return -1;
    }
    return 0;
}

real signf(x: real) {
    if (x > 0.0) {
        return 1.0;
    }
    if (x < 0.0) {
        return -1.0;
    }
    return 0.0;
}

real minf(a: real, b: real) {
    if (a < b) {
        return a;
    }
    return b;
}

real maxf(a: real, b: real) {
    if (a > b) {
        return a;
    }
    return b;
}

real clampf(v: real, lo: real, hi: real) {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

real floorf(x: real) {
    return libc.floor(x);
}

real ceilf(x: real) {
    return libc.ceil(x);
}

real roundf(x: real) {
    return libc.round(x);
}

real sqrtf(x: real) {
    return libc.sqrt(x);
}

real sin(x: real) {
    return libc.sin(x);
}

real cos(x: real) {
    return libc.cos(x);
}

real tan(x: real) {
    return libc.tan(x);
}

real exp(x: real) {
    return libc.exp(x);
}

real log(x: real) {
    return libc.log(x);
}

real log2(x: real) {
    return libc.log2(x);
}

real powf(base: real, exponent: real) {
    return libc.pow(base, exponent);
}

real atan(x: real) {
    return libc.atan(x);
}

real atan2(y: real, x: real) {
    return libc.atan2(y, x);
}

real log10(x: real) {
    return libc.log10(x);
}

real asin(x: real) {
    return libc.asin(x);
}

real acos(x: real) {
    return libc.acos(x);
}

real sinh(x: real) {
    return libc.sinh(x);
}

real cosh(x: real) {
    return libc.cosh(x);
}

real tanh(x: real) {
    return libc.tanh(x);
}

real hypot(x: real, y: real) {
    return libc.hypot(x, y);
}

real cbrt(x: real) {
    return libc.cbrt(x);
}

real truncf(x: real) {
    return libc.trunc(x);
}

real fmod(x: real, y: real) {
    return libc.fmod(x, y);
}
