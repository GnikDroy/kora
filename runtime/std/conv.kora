# Converts any supported value: the primitives here, or any struct with a
# `string __str__(self)` method.
string to_string<T>(v: T) {
    if T == int {
        if (v == 0) {
            return "0";
        }
        let negative = v < 0;
        if (negative) {
            v = -v;
        }
        let digits: [char] = [];
        while (v > 0) {
            digits.insert(0, ((v % 10) + 48) as char);
            v = v / 10;
        }
        if (negative) {
            digits.insert(0, '-');
        }
        return digits;
    } else if T == real {
        if (v != v) {
            return "nan";
        }
        if (v * 0.5 == v && v != 0.0) {
            if (v > 0.0) {
                return "inf";
            }
            return "-inf";
        }
        let s = "";
        if (v < 0.0) {
            s.push('-');
            v = -v;
        }
        let whole = v as int;
        s = s + to_string::<int>(whole);
        s.push('.');
        let frac = v - (whole as real);
        let digits = 0;
        while (digits < 6) {
            frac = frac * 10.0;
            let d = frac as int;
            s.push((d + 48) as char);
            frac = frac - (d as real);
            digits = digits + 1;
        }
        while (s[s.len() - 1] == '0' && s[s.len() - 2] != '.') {
            s.pop();
        }
        return s;
    } else if T == bool {
        if (v) {
            return "true";
        }
        return "false";
    } else if T == char {
        let s: [char] = [];
        s.push(v);
        return s;
    } else if T == string {
        return v;
    } else {
        return v.__str__();
    }
}

int? string_to_int(s: string) {
    if (s.len() == 0) {
        return none;
    }
    let i = 0;
    let negative = false;
    if (s[0] == '-') {
        negative = true;
        i = 1;
    } else if (s[0] == '+') {
        i = 1;
    }
    if (i == s.len()) {
        return none;
    }
    let value = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c < '0' || c > '9') {
            return none;
        }
        value = value * 10 + ((c as int) - 48);
        i = i + 1;
    }
    if (negative) {
        return -value;
    }
    return value;
}
