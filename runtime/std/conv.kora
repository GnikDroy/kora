string int_to_string(n: int) {
    if (n == 0) {
        return "0";
    }
    let negative = n < 0;
    if (negative) {
        n = -n;
    }
    let digits: [char] = [];
    while (n > 0) {
        digits.insert(0, ((n % 10) + 48) as char);
        n = n / 10;
    }
    if (negative) {
        digits.insert(0, '-');
    }
    return digits;
}

string real_to_string(x: real) {
    let s = "";
    if (x < 0.0) {
        s.push('-');
        x = -x;
    }
    let whole = x as int;
    s = s + int_to_string(whole);
    s.push('.');
    let frac = x - (whole as real);
    let digits = 0;
    while (digits < 6) {
        frac = frac * 10.0;
        let d = frac as int;
        s.push((d + 48) as char);
        frac = frac - (d as real);
        digits = digits + 1;
    }
    while (s[s.len() - 1] == '0' && s[s.len() - 2] != '.') {
        s.pop();
    }
    return s;
}

string bool_to_string(b: bool) {
    if (b) {
        return "true";
    }
    return "false";
}

string char_to_string(c: char) {
    let s: [char] = [];
    s.push(c);
    return s;
}

int? string_to_int(s: string) {
    if (s.len() == 0) {
        return none;
    }
    let i = 0;
    let negative = false;
    if (s[0] == '-') {
        negative = true;
        i = 1;
    } else if (s[0] == '+') {
        i = 1;
    }
    if (i == s.len()) {
        return none;
    }
    let value = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c < '0' || c > '9') {
            return none;
        }
        value = value * 10 + ((c as int) - 48);
        i = i + 1;
    }
    if (negative) {
        return -value;
    }
    return value;
}
